# Project folders (Bob, 2026-10-26): each job/Project-*/ keeps working copies in _work/ and build output in Exports/.
job/*/_work/
job/*/03_Working_Design/Exports/
# Job-level working copies (the Drive folder's local path, drive-root.txt; Bob, 2026-10-26).
job/_work/
harness/tools/
__pycache__/
*.pyc
*.tmp
*.bak
~$*
# AutoCAD lock and autosave files
*.dwl
*.dwl2
*.sv$
plot.log
# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.venv/
# _work/ also holds the derived lists-viewer.xlsx (rebuild: harness/scripts/build_lists_workbook.ps1).
# Model builds (model_iterate.py, fast and full; Bob, 2026-10-10 and 2026-11-12): working copies, not revisions; never
# committed or pushed. Fast_Builds is the folder's name before 2026-11-12, until a checkout's first build renames it.
job/*/03_Working_Design/CAD/Builds/
job/*/03_Working_Design/CAD/Fast_Builds/
# P&ID fast edits (model-to-pid.py --fast; Bob, 2026-10-11): viewing copies, not revisions; never committed or pushed.
job/*/03_Working_Design/PID/Fast_Edits/

